{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Expo",
      "type": "shell",
      "command": "npx",
      "args": ["expo", "start"],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
